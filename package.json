{
  "name": "opencode-gnome",
  "description": "Client GNOME (application + extension Shell) pour opencode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gnim-types": "node scripts/gnim-types.ts",
    "typecheck": "node scripts/gnim-types.ts && tsc && tsc -p src/shared && tsc -p src/app && tsc -p src/cli && tsc -p specs",
    "lint": "oxlint --type-aware",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build": "node scripts/build.ts",
    "start": "node scripts/build.ts && gjs -m dist/app/main.js",
    "install-local": "node scripts/install.ts",
    "screenshot": "node scripts/screenshot.ts",
    "test": "node scripts/test.ts",
    "fake-opencode": "node scripts/fake-opencode.ts",
    "e2e": "node scripts/e2e.ts"
  },
  "dependencies": {
    "gnim": "^1.9.1",
    "qrcode-generator": "2.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@girs/adw-1": "^5.5.0",
    "@girs/gda-6.0": "6.0.0-4.0.4",
    "@girs/gio-2.0": "5.5.0",
    "@girs/gjs": "^5.5.0",
    "@girs/glib-2.0": "5.5.0",
    "@girs/gobject-2.0": "5.5.0",
    "@girs/gsound-1.0": "5.5.0",
    "@girs/gtk-4.0": "^5.5.0",
    "@girs/gtksource-5": "5.5.0",
    "@girs/pango-1.0": "5.5.0",
    "@girs/soup-3.0": "^5.5.0",
    "@girs/vte-3.91": "5.5.0",
    "@types/jasmine": "~3.10.19",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24"
  }
}
